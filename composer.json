{
    "name": "baizman-design/disk-usage-mu",
    "description": "A WordPress must-use plugin displaying disk usage.",
    "homepage": "https://github.com/baizman-design/disk-usage-mu",
    "type": "wordpress-plugin",
    "license": "BSD-3-Clause",
    "keywords": [
        "wordpress",
        "plugin",
        "php"
    ],
    "authors": [
        {
            "name": "Saul Baizman",
            "email": "saul@baizmandesign.com",
            "homepage": "https://baizmandesign.com"
        }
    ],
    "support": {
        "issues": "https://github.com/baizman-design/disk-usage-mu/issues/new"
    },
    "require": {
        "php": "8.*.*"
    },
    "require-dev": {
        "wp-cli/i18n-command": "^2",
        "yoast/phpunit-polyfills": "^4.0",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "disk_usage_mu\\": ["tests/"]
        }
    },
    "scripts": {
        "makepot": "wp i18n make-pot ."
    }
},
